<Window x:Class="RdpVault.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RdpVault"
        mc:Ignorable="d"
        Title="RDP Vault" Height="650" Width="1000" MinHeight="480" MinWidth="760"
        Icon="Assets/icon.ico"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush1}" BorderThickness="0,0,0,1">
            <Grid Margin="20,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="RDP Vault" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>

                <Border Grid.Column="2" Background="{DynamicResource InputBackgroundBrush}" CornerRadius="8" Padding="10,7" Width="260" Margin="0,0,12,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Width="13" Height="13" Margin="0,0,8,0" Stretch="Uniform"
                              Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Data="{StaticResource IconSearch}" VerticalAlignment="Center"/>
                        <Grid Grid.Column="1">
                            <TextBlock x:Name="SearchPlaceholder" Text="Search servers..." Foreground="{DynamicResource TextSecondaryBrush}" IsHitTestVisible="False"/>
                            <TextBox x:Name="SearchBox" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" TextChanged="SearchBox_TextChanged"/>
                        </Grid>
                    </Grid>
                </Border>

                <Button Grid.Column="3" Style="{StaticResource SecondaryButton}" Content="⋯" Padding="14,8" Margin="0,0,10,0" Click="MoreButton_Click"/>

                <Button Grid.Column="4" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="AddGroupButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="12" Height="12" Margin="0,0,6,0" Stretch="Uniform" Fill="{DynamicResource TextPrimaryBrush}" Data="{StaticResource IconFolder}"/>
                        <TextBlock Text="+ Group"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="5" Style="{StaticResource RoundIconButton}" ToolTip="Add server" Click="AddServerButton_Click">
                    <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource ButtonTextBrush}" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="{StaticResource IconPlus}"/>
                </Button>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush1}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,14">
                    <TreeView x:Name="ServerTree" BorderThickness="0" Background="Transparent"
                              SelectedItemChanged="ServerTree_SelectedItemChanged"
                              ContextMenuOpening="ServerTree_ContextMenuOpening"/>
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Column="1" Width="1" Background="{DynamicResource BorderBrush1}" HorizontalAlignment="Stretch"/>

            <!-- Detail panel -->
            <Grid Grid.Column="2" Margin="40,32">
                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Visible">
                    <Path Width="40" Height="40" Stretch="Uniform" Opacity="0.35" HorizontalAlignment="Center"
                          Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Data="{StaticResource IconMonitor}"/>
                    <TextBlock Text="Select a server to see details" Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="14" Margin="0,12,0,0" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel x:Name="DetailContent" Visibility="Collapsed" MaxWidth="480" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding Server.Name}" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding HostPort}" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,24"/>

                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush1}" BorderThickness="1" CornerRadius="10" Padding="20">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Username" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"/>
                                <TextBlock Grid.Column="1" Text="{Binding Server.Username}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Grid>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Domain" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"/>
                                <TextBlock Grid.Column="1" Text="{Binding Server.Domain}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Group" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"/>
                                <TextBlock Grid.Column="1" Text="{Binding GroupName}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Click="ConnectButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="14" Height="14" Margin="0,0,8,0" Stretch="Uniform" Stroke="{DynamicResource ButtonTextBrush}" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="{StaticResource IconMonitor}"/>
                                <TextBlock Text="Connect"/>
                            </StackPanel>
                        </Button>
                        <Button Content="Edit" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="EditButton_Click"/>
                        <Button Content="Copy" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Click="CopyButton_Click"/>
                        <Button Content="Delete" Style="{StaticResource SecondaryButton}" Click="DeleteButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
